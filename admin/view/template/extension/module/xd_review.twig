{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-xd-review" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-xd-review" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10"><select name="module_xd_review_status" id="input-status" class="form-control">
              <option value="1"{% if module_xd_review_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
              <option value="0"{% if not module_xd_review_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
            </select></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-moderation">{{ entry_moderation }}</label>
            <div class="col-sm-10"><select name="module_xd_review_moderation" id="input-moderation" class="form-control">
              <option value="1"{% if module_xd_review_moderation %} selected="selected"{% endif %}>{{ text_yes }}</option>
              <option value="0"{% if not module_xd_review_moderation %} selected="selected"{% endif %}>{{ text_no }}</option>
            </select></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-guest">{{ entry_guest }}</label>
            <div class="col-sm-10"><select name="module_xd_review_guest" id="input-guest" class="form-control">
              <option value="1"{% if module_xd_review_guest %} selected="selected"{% endif %}>{{ text_yes }}</option>
              <option value="0"{% if not module_xd_review_guest %} selected="selected"{% endif %}>{{ text_no }}</option>
            </select></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-min-length">{{ entry_min_length }}</label>
            <div class="col-sm-10"><input type="number" min="1" max="1000" name="module_xd_review_min_length" value="{{ module_xd_review_min_length }}" id="input-min-length" class="form-control" />
              <p class="help-block">{{ help_min_length }}</p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
